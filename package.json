{
  "name": "hannah-home",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "build": "npm run verify:source && npm audit --audit-level=high && next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "verify:source": "node scripts/verify-source.mjs",
    "verify": "npm run verify:source && npm run typecheck && npm test && npm audit --audit-level=high",
    "test:api": "node tests/api-smoke.mjs",
    "dev:preview": "HANNAH_DEMO_MODE=true next dev --webpack --hostname 0.0.0.0",
    "check:env": "node scripts/check-env.mjs",
    "setup:browser-tests": "node scripts/setup-browser-tests.mjs",
    "test:browser": "node tests/browser-smoke.mjs",
    "test:accessibility": "node tests/accessibility-smoke.mjs",
    "test:site-tools": "node tests/site-tools-smoke.mjs",
    "test:production": "node tests/production-smoke.mjs"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "next-auth": "5.0.0-beta.32",
    "framer-motion": "12.18.0",
    "lucide-react": "0.523.0",
    "@vercel/kv": "3.0.0",
    "@vercel/blob": "2.8.2",
    "nodemailer": "10.1.7",
    "react-hook-form": "7.57.0",
    "zod": "3.25.67",
    "recharts": "2.15.3",
    "zustand": "5.0.6",
    "gsap": "3.12.7",
    "lenis": "1.3.4",
    "qrcode": "1.5.4",
    "jspdf": "4.2.1",
    "html2canvas": "1.4.1",
    "@vercel/analytics": "1.5.0",
    "@vercel/speed-insights": "1.2.0"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "@types/node": "24.0.10",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.6",
    "tailwindcss": "4.1.10",
    "postcss": "8.5.30",
    "autoprefixer": "10.4.21",
    "@types/nodemailer": "6.4.17"
  },
  "overrides": {
    "postcss": "8.5.30",
    "sharp": "0.35.5",
    "sprintf-js": "1.1.3",
    "motion-dom": "12.17.3",
    "motion-utils": "12.12.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module"
}
